import { ensure_jq, jq_get_json, jq_set_json } from "./json.ab"
import { fetch_models } from "./provider/openai.ab"

/// Reads the conversation from `path` as compact JSON, or "" when it is empty.
pub fun read_messages(path: Text): Text {
    const messages = jq_get_json(path, "messages")
    if messages == "" or messages == "[]" {
        return ""
    }
    return messages
}

/// Empties the conversation at `path`, keeping the other fields.
pub fun clear_messages(path: Text): Bool {
    return jq_set_json(path, "messages", "[]")
}

/// Appends one compact JSON message object to a message array.
pub fun push_message_json(messages_json: Text, message_json: Text): Text {
    const jq = ensure_jq()
    if jq == "" {
        return ""
    }
    const messages = $ printf '%s' "{messages_json}" | {jq} -c --argjson message "{message_json}" '. + [\$message]' $ failed {
        return ""
    }
    return messages
}

/// Appends one {role, content} message to a message array.
pub fun push_message(messages_json: Text, role: Text, content: Text): Text {
    const jq = ensure_jq()
    if jq == "" {
        return ""
    }
    const message = $ {jq} -n -c --arg role "{role}" --arg content "{content}" '\{role: \$role, content: \$content}' $ failed {
        return ""
    }
    if message == "" {
        return ""
    }
    return push_message_json(messages_json, message)
}

/// Builds the [system, user] message array that starts a conversation.
pub fun first_messages(system_prompt: Text, prompt: Text): Text {
    const jq = ensure_jq()
    if jq == "" {
        return ""
    }
    const messages = $ {jq} -n -c \
        --arg system "{system_prompt}" \
        --arg user "{prompt}" \
        '[\{role: "system", content: \$system}, \{role: "user", content: \$user}]' $ failed {
        return ""
    }
    return messages
}

/// Returns the model ids offered by the configured API endpoint.
pub fun list_models(): [Text] {
    return fetch_models()
}
