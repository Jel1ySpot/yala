import { ensure_state_dir } from "../json.ab"

/// Runs `command` in a bash subshell, writing its combined output to `path`.
///
/// stdout and stderr are redirected into `path`; a failing command gets its
/// exit code appended so the caller can tell what happened. Returns true when
/// the output file was written.
fun capture(prefix: Text, command: Text, path: Text): Bool {
    if not ensure_state_dir() {
        return false
    }
    if path == "" {
        return false
    }
    $ {prefix} bash -c "{command}" > "{path}" 2>&1 $ failed(code) {
        trust $ if [ -s "{path}" ]; then printf '\n[exit code: %s]' "{code}" >> "{path}"; else printf '[exit code: %s]' "{code}" > "{path}"; fi $
        return true
    }
    return true
}

/// Runs a bash command and writes its output to `path`.
pub fun run_to(command: Text, path: Text): Bool {
    return capture("", command, path)
}

/// Runs a bash command with sudo and writes its output to `path`.
pub fun sudo_run_to(command: Text, path: Text): Bool {
    return capture("sudo", command, path)
}
